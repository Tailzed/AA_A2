{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio 2026 + vcpkg manifest)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release" }
  ]
}
